{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfusion.local/schemas/v1/foundry-evaluation-result.schema.json",
  "title": "FoundryEvaluationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_hash", "system_version", "metrics", "trust_decision", "evaluated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_hash": {"type": "string"},
    "system_version": {"type": "string"},
    "metrics": {"type": "object"},
    "trust_decision": {"enum": ["FOUNDRY_V1_TRUSTED", "NOT_TRUSTED", "INCONCLUSIVE"]},
    "evaluated_at": {"type": "string", "format": "date-time"}
  }
}

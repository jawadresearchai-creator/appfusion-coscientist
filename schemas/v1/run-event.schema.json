{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfusion.local/schemas/v1/run-event.schema.json",
  "title": "RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "run_id", "sequence", "event_type", "occurred_at", "actor", "payload"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "event_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "stream_id": {"type": "string", "minLength": 1},
    "previous_event_id": {"type": ["string", "null"], "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {"required": ["stream_id", "previous_event_id", "idempotency_key"]}
    }
  ]
}

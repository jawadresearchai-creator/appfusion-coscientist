{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfusion.local/schemas/v1/approval-event.schema.json",
  "title": "ApprovalEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "approval_id", "event_type", "actor", "occurred_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "approval_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["APPROVAL_REVOKED", "APPROVAL_SUPERSEDED"]},
    "actor": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string"},
    "superseding_approval_id": {"type": "string", "format": "uuid"}
  }
}

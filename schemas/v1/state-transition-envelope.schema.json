{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfusion.local/schemas/v1/state-transition-envelope.schema.json",
  "title": "StateTransitionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "app_id", "holder_id", "lease_token", "expected_registry_revision", "expected_application_state_revision", "event_sequence", "event_type", "event_summary", "occurred_at", "actor", "next_lifecycle_state", "next_phase", "next_safe_action", "delivery_plan_id"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"type": "string", "format": "uuid"},
    "app_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "holder_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "lease_token": {"type": "string", "format": "uuid"},
    "expected_registry_revision": {"type": "integer", "minimum": 1},
    "expected_application_state_revision": {"type": "integer", "minimum": 1},
    "event_sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "event_summary": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "next_lifecycle_state": {"enum": ["REGISTERED", "FOUNDRY_ANALYSIS", "AWAITING_BLUEPRINT_APPROVAL", "PRODUCT_CONSTRUCTION", "VALIDATION", "RELEASE_CANDIDATE", "RELEASED", "PAUSED", "FAILED", "ARCHIVED"]},
    "next_phase": {"type": "string", "minLength": 1},
    "next_safe_action": {"type": "string", "minLength": 1},
    "delivery_plan_id": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}

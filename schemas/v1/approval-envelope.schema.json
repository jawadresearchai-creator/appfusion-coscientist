{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfusion.local/schemas/v1/approval-envelope.schema.json",
  "title": "ApprovalEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "foundry_dossier_sha256", "product_blueprint_sha256", "approver_principal", "approved_at", "policy_bundle_hash", "clean_room_schema_version", "approval_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approval_id": {"type": "string", "format": "uuid"},
    "foundry_dossier_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "product_blueprint_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "approver_principal": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "policy_bundle_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "clean_room_schema_version": {"type": "string", "minLength": 1},
    "approval_status": {"const": "APPROVED"},
    "conditions": {"type": "array", "items": {"type": "string"}}
  }
}

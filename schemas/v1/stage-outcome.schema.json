{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfusion.local/schemas/v1/stage-outcome.schema.json",
  "title": "StageOutcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "outcome", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["PASS", "FAIL", "SKIPPED_NOT_APPLICABLE", "SKIPPED_POLICY", "BLOCKED_AUTHORIZATION", "BLOCKED_ENVIRONMENT", "BLOCKED_SECURITY_ENVIRONMENT", "BLOCKED_BUDGET", "INCONCLUSIVE", "CANCELLED"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

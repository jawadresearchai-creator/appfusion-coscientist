{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfusion.local/schemas/v1/application-lease.schema.json",
  "title": "ApplicationLease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_id", "holder_id", "lease_token", "acquired_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "app_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "holder_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "lease_token": {"type": "string", "format": "uuid"},
    "acquired_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
